<mujoco model="ur3e scene">

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" specular="0" shininess="0.5" reflectance="0" rgba="0.93 0.93 0.93 1"></material>
  </asset>

  <include file="ur3e.xml"/>
    
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body pos="0.8 0.75 0" name="target0">
      <!--<geom conaffinity="0" contype="0" pos="0 0 0" rgba="0 1 0 1" size="0.02 0.02 0.02" type="sphere" name="target0"></geom>-->
      <site name="target0" pos="0 0 0.5" size="0.02 0.02 0.02" rgba="0 1 0 1" type="sphere"></site>
    </body>
    
    <body pos="1.3 0.75 0.2" name="table0">
      <geom name="table0" mass="2000" size="0.25 0.35 0.2" type="box" material="table_mat" ></geom> <!-- friction="0.5" solimp="0.95 0.99 0.001" solref="0.004 1" -->
    </body>        

    <body pos="0.025 0.025 0.025" name="object0">
      <joint name="object0:joint" type="free" damping="0.01"/>
      <geom name="object0" size="0.025 0.025 0.025" type="box" rgba="0 0 0 0" mass="0.0001" contype="0" conaffinity="0"/>
      <site name="object0" pos="0 0 0" size="0.02 0.02 0.02" rgba="0 0 0 0" type="sphere"/>
    </body>
     
      
        <!-- mocap as gripper tcp -->
    <body mocap="true" name="robot0:mocap" pos="0.0  0.0  0.0" > <!-- pos="0.2982001  0.1311989  0.44540031"-->
      <geom conaffinity="0" contype="0" pos="0 0 0" rgba="0 0.5 0 0.7" size="0.005 0.005 0.005" type="box"></geom>
      <geom conaffinity="0" contype="0" pos="0 0 0" rgba="0 0.5 0 0.1" size="1.5 0.005 0.005" type="box"></geom>
      <geom conaffinity="0" contype="0" pos="0 0 0" rgba="0 0.5 0 0.1" size="0.005 1 0.001" type="box"></geom>
      <geom conaffinity="0" contype="0" pos="0 0 0" rgba="0 0.5 0 0.1" size="0.005 0.005 1" type="box"></geom>
    </body>

  </worldbody>   
  
</mujoco>

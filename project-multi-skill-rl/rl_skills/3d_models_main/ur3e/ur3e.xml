          <geom class="collision" pos="0 -0.03 0" quat="1 1 0 0" size="0.055 0.055"/> 
          <geom class="collision" size="0.05 0.1" pos="0 0 0.15"/>
          <body name="forearm_link" pos="0 -0.0921 0.24355"> 
            <inertial pos="-0.1066 0 0.027" quat="0.707107 0 0.707107 0" mass="1.43" diaginertia="0.00654457 0.00654457 0.00354375"/>
            <joint name="robot0:elbow_joint" class="size1"pos="0 0 0" axis="0 1 0" range="-3.14159 3.14159"/>
            <geom quat="0.707107 0.707107 0 0" material="jointgray" class="visual" mesh="forearm_0"/> 
            <geom quat="0.707107 0.707107 0 0" material="black" class="visual" mesh="forearm_1"/> 
            <geom quat="0.707107 0.707107 0 0" material="linkgray" class="visual" mesh="forearm_2"/> 
            <geom quat="0.707107 0.707107 0 0" material="black" class="visual" mesh="forearm_3"/> 
            <geom quat="0.707107 0.707107 0 0" material="urblue" class="visual" mesh="forearm_4"/> 
            <geom quat="0.707107 0.707107 0 0" material="black" class="visual" mesh="forearm_5"/> 
            <geom quat="0.707107 0.707107 0 0" material="jointgray" class="visual" mesh="forearm_6"/> 
            <geom class="collision" pos="0 0.08 0" quat="1 1 0 0" size="0.045 0.045"/>
            <geom class="collision" size="0.04 0.1" pos="0 0 0.1"/>

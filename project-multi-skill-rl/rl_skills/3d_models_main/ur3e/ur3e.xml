                <body name="wrist_3_link" pos="0 0 0.085"> 
                  <inertial pos="0 0 -0.02" quat="0.5 0.5 -0.5 0.5" mass="0.26" diaginertia="0.0001792 0.000136267 0.000136267"/>
                  <joint name="robot0:wrist_3_joint" class="size0" pos="0 0 0" axis="0 1 0" range="-6.28319 6.28319"/>

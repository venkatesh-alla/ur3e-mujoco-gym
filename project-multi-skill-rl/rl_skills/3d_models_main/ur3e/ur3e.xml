                  <site name="attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/> -->                 
                  <site name="robot0:TCP" pos="0.0007 0.235 0.000" quat="0 0 1 0" type="box" size="0.005 0.005 0.005" rgba="0.8 0.2 0.2 0.7"/>
                  <body name="robot0:TCP_body" pos="0.0007 0.235 0.000" quat="0 0 1 0">
                    <inertial mass="0.0" pos="0 0 0.0" diaginertia="0.00 0.00 0.00"/>

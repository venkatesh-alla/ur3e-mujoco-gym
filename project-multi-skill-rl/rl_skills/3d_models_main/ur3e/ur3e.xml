          <geom quat="0.707107 0.707107 0 0" material="linkgray" class="visual" mesh="upperarm_3"/> 
          <geom quat="0.707107 0.707107 0 0" material="black" class="visual" mesh="upperarm_4"/> 
          <geom quat="0.707107 0.707107 0 0" material="urblue" class="visual" mesh="upperarm_5"/> 
          <geom quat="0.707107 0.707107 0 0" material="black" class="visual" mesh="upperarm_6"/> 
          <geom quat="0.707107 0.707107 0 0" material="jointgray" class="visual" mesh="upperarm_7"/> 

      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom quat="0.707107 0.707107 0 0" mesh="base_0" material="black" class="visual"/>
      <geom quat="0.707107 0.707107 0 0" mesh="base_1" material="jointgray" class="visual"/>
      <body name="shoulder_link" pos="0 0 0.15185"> 
        <inertial pos="0 0 0" mass="2" diaginertia="0.00809316 0.00809316 0.005625"/>
        <joint name="robot0:shoulder_pan_joint" class="size2" pos="0 0 0" axis="0 0 1" range="-6.28319 6.28319"/>
        <geom quat="0.707107 0.707107 0 0" mesh="shoulder_0" material="black" class="visual"/>
        <geom quat="0.707107 0.707107 0 0" mesh="shoulder_1" material="urblue" class="visual"/>
        <geom quat="0.707107 0.707107 0 0" mesh="shoulder_2" material="jointgray" class="visual"/>
        <geom class="collision" size="0.055 0.055" pos="0 0 -0.03"/>
        <body name="upper_arm_link" pos="0 0.12 0" quat="0.707107 0 0.707107 0"> 
          <inertial pos="-0.121825 0 0.12" quat="0.707107 0 0.707107 0" mass="3.42" diaginertia="0.0217285 0.0217285 0.00961875"/>
          <joint name="robot0:shoulder_lift_joint" class="size2"pos="0 0 0" axis="0 1 0" range="-6.28319 6.28319"/>
          <geom quat="0.707107 0.707107 0 0" material="urblue" class="visual" mesh="upperarm_0"/>
          <geom quat="0.707107 0.707107 0 0" material="jointgray" class="visual" mesh="upperarm_1"/> 
